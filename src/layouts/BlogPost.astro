---
import BaseLayout from './BaseLayout.astro';
import EmailNotify from '../components/EmailNotify.astro';
import PostNavigation from '../components/PostNavigation.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { AUTHOR } from '../config';
import { slugify } from '../utils/posts';
import type { RelatedPost } from '../utils/related';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  categories?: string[];
  olderPost?: { slug: string; title: string } | null;
  newerPost?: { slug: string; title: string } | null;
  relatedPosts?: RelatedPost[];
}

const { title, description, pubDate, updatedDate, heroImage, categories, olderPost, newerPost, relatedPosts } = Astro.props;

// Calculate reading time (rough estimate: 200 words per minute)
const content = await Astro.slots.render('default');
const wordCount = content.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);

// Format canonical URL to match WordPress structure
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

// Absolute image URL for structured data — use the post's heroImage when set,
// otherwise the site default OG image (mirrors BaseLayout's og:image fallback).
const schemaImage = new URL(heroImage ?? '/og-images/aaron-roy-dot-com-og.png', Astro.site).toString();
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  ogImage={heroImage}
  ogType="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={(updatedDate || pubDate).toISOString()}
>
  <article class="max-w-3xl mx-auto px-6 py-12">
    <!-- Back link -->
    <div class="mb-8">
      <a href="/writing/" class="text-sm text-gray-600 hover:text-gray-900 transition-colors inline-flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        Writing
      </a>
    </div>

    <!-- Article Header -->
    <header class="mb-12">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4 leading-tight">{title}</h1>

      {/*
        The frontmatter description, rendered as a standfirst.

        It was previously written on every post but only ever reached a meta tag
        and the JSON-LD — never the visible body. That mattered because retrieval
        systems snapshot a short span anchored to the H1 and reuse it as the
        page's snippet regardless of the query, and on this site that span opened
        with "August 19, 2026 - 14 min read - Agents, Projects" followed by
        whatever the first sentence happened to be. The flagship cost post never
        mentioned its 309 model runs anywhere a machine would look.

        Headline -> standfirst -> byline is also just the conventional editorial
        order, and it earns its place for readers too: 47% of this site's traffic
        arrives from LinkedIn on a single deep link, and the dek is what tells
        someone what they've clicked into before committing to a 14-minute read.
      */}
      <p class="text-lg sm:text-xl text-gray-600 leading-relaxed mb-6">{description}</p>

      <div class="flex items-center gap-3 text-sm text-gray-600">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('en-us', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <span>•</span>
        <span>{readingTime} min read</span>
        {categories && categories.length > 0 && (
          <>
            <span>•</span>
            <span>
              {categories.map((category, index) => (
                <><a
                  href={`/category/${slugify(category)}/`}
                  class="hover:text-blue-600 transition-colors"
                >{category}</a>{index < categories.length - 1 && ', '}</>
              ))}
            </span>
          </>
        )}
      </div>

      {updatedDate && (
        <div class="mt-2 text-sm text-gray-500 italic">
          Updated {updatedDate.toLocaleDateString('en-us', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </div>
      )}
    </header>

    <!-- Article Content -->
    <div class="prose prose-lg max-w-none
      prose-headings:font-semibold prose-headings:tracking-tight
      prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6
      prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-4
      prose-p:leading-relaxed prose-p:mb-6
      prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline
      prose-img:rounded-lg prose-img:my-8
      prose-ul:my-6 prose-li:my-2
      prose-strong:font-semibold
      prose-blockquote:border-l-4 prose-blockquote:border-gray-300 prose-blockquote:pl-6 prose-blockquote:italic">
      <slot />
    </div>
  </article>

  <EmailNotify />

  <RelatedPosts posts={relatedPosts ?? []} />

  <PostNavigation olderPost={olderPost ?? null} newerPost={newerPost ?? null} />

  <!-- Structured Data for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "url": canonicalURL,
    "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL },
    "image": schemaImage,
    "datePublished": pubDate.toISOString(),
    "dateModified": (updatedDate || pubDate).toISOString(),
    "inLanguage": "en-US",
    "timeRequired": `PT${readingTime}M`,
    ...(categories && categories.length > 0 ? {
      "keywords": categories,
      "articleSection": categories[0],
    } : {}),
    "author": {
      "@type": "Person",
      "@id": AUTHOR.id,
      "name": AUTHOR.name,
      "url": AUTHOR.url,
      "sameAs": [
        AUTHOR.social.twitter,
        AUTHOR.social.linkedin,
        AUTHOR.social.github,
        AUTHOR.social.youtube,
      ]
    },
    "publisher": {
      "@id": AUTHOR.id
    }
  })} />
</BaseLayout>
