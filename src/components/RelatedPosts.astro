---
import type { RelatedPost } from '../utils/related';

interface Props {
  posts: RelatedPost[];
}

const { posts } = Astro.props;

if (posts.length === 0) return;
---

<aside aria-labelledby="related-heading" class="max-w-3xl mx-auto px-6 mt-16 pt-8 border-t border-gray-200">
  <h2 id="related-heading" class="text-sm font-semibold text-gray-900 uppercase mb-6">Related reading</h2>

  <div class="space-y-6">
    {posts.map((post) => (
      <article>
        <a href={`/${post.slug}/`} class="group block">
          <h3 class="text-xl font-semibold text-blue-600 group-hover:underline transition-colors mb-1">
            {post.title}
          </h3>
          <p class="text-gray-600 leading-relaxed">{post.description}</p>
        </a>
      </article>
    ))}
  </div>
</aside>
