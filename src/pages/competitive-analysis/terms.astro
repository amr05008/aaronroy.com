---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Copy lives in src/content/competitive-analysis/terms.md.
const page = (await getEntry('competitive-analysis', 'terms'))!;
const { Content } = await page.render();
---

<BaseLayout title={page.data.title} description={page.data.description} noindex={true}>
  <div class="max-w-3xl mx-auto px-6 pt-16 pb-16">
    <div class="prose prose-lg max-w-none
      prose-h1:text-4xl md:prose-h1:text-5xl prose-h1:font-bold prose-h1:tracking-tight prose-h1:mb-12
      prose-h2:text-2xl prose-h2:font-semibold prose-h2:mt-12 prose-h2:mb-6
      prose-p:leading-relaxed prose-p:mb-6
      prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline">
      <Content />
    </div>
  </div>
</BaseLayout>
